datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  phone     String   @unique
  password  String
  role      String   // "CUSTOMER" or "WORKER"
  createdAt DateTime @default(now())
}
